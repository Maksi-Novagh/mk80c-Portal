{
  "redirects": [
    { "source": "/about.html", "destination": "/about", "type": 301 },
    { "source": "/projects.html", "destination": "/projects", "type": 301 },
    { "source": "/project.html", "destination": "/project", "type": 301 },
    { "source": "/contact.html", "destination": "/contact", "type": 301 }
  ],

  "routes": [
    { "src": "/about", "dest": "/about.html" },
    { "src": "/projects", "dest": "/projects.html" },
    { "src": "/project", "dest": "/project.html" },
    { "src": "/contact", "dest": "/contact.html" },
    { "src": "/*", "dest": "/index.html" }
  ],

  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
